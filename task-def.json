{
  "family": "dte-firmador-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::375609200435:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "svfe-api-firmador",
      "image": "375609200435.dkr.ecr.us-east-1.amazonaws.com/svfe-api-firmador:v20230109",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8113,
          "hostPort": 8113,
          "protocol": "tcp"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "svfe-uploads",
          "containerPath": "/app/temp",
          "readOnly": false
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "svfe-uploads",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-09b6bbff2f85fe78a",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED"
      }
    }
  ]
}
